generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model disco {
  id          Int    @id @default(autoincrement())
  titulo      String
  artista     String
  genero      String
  preco_custo String
  preco_venda String
  quantidade  String
  estoque_min String

  movimentacoes movimentacao[]
}

model usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String

  movimentacoes movimentacao[]
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

model movimentacao {
  id         Int              @id @default(autoincrement())
  tipo       TipoMovimentacao
  data       DateTime
  quantidade Int
  discoId    Int
  usuarioId  Int

  disco   disco   @relation(fields: [discoId], references: [id])
  usuario usuario @relation(fields: [usuarioId], references: [id])
}
